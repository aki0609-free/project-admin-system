<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="envelope_kaku2"
    pageWidth="941"
    pageHeight="680"
    columnWidth="901"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="22222222-2222-2222-2222-222222222222">

    <field name="customerName" class="java.lang.String"/>
    <field name="postalCode" class="java.lang.String"/>
    <field name="address" class="java.lang.String"/>
    <field name="stamp" class="java.lang.String"/>
    <field name="honorific" class="java.lang.String"/>

    <detail>
        <band height="640">
            <textField isBlankWhenNull="true">
                <reportElement x="180" y="120" width="620" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="IPAexGothic" size="15"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    ($F{postalCode} == null || $F{postalCode}.isBlank() ? "" : "〒" + $F{postalCode} + "　")
                    + ($F{address} == null ? "" : $F{address})
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="190" y="200" width="600" height="52"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="IPAexGothic" size="24"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    ($F{customerName} == null ? "" : $F{customerName})
                    + ($F{honorific} == null || $F{honorific}.isBlank() ? "" : "　" + $F{honorific})
                ]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="180" y="255" width="620" height="1"/>
            </line>
            <line>
                <reportElement x="180" y="262" width="620" height="1"/>
            </line>

            <textField isBlankWhenNull="true">
                <reportElement x="95" y="360" width="145" height="44"/>
                <box>
                    <pen lineWidth="1.2"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="IPAexGothic" size="17" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{stamp}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
