    <staticText><reportElement style="Label" x="0" y="326" width="170" height="34"/><text><![CDATA[建設リサイクル法]]></text></staticText>
    <staticText><reportElement style="CellCenter" x="170" y="326" width="130" height="34"/><text><![CDATA[該当しない]]></text></staticText>
