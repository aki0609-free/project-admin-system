    <staticText><reportElement style="CellCenter" x="90" y="372" width="250" height="48"/><text><![CDATA[部分払・完成払　現金 100%]]></text></staticText>
    <staticText><reportElement style="Label" x="340" y="372" width="120" height="48"/><text><![CDATA[履行遅滞の遅延利息]]></text></staticText>
