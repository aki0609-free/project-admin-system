    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="daily_pay_slip"
    pageWidth="516"
    pageHeight="729"
    columnWidth="488"
    leftMargin="14"
    rightMargin="14"
    topMargin="14"
    bottomMargin="14"
    whenNoDataType="AllSectionsNoDetail"
>
    <property name="net.sf.jasperreports.default.font.name" value="IPAexGothic"/>
    <property name="net.sf.jasperreports.export.pdf.tagged" value="true"/>

    <style name="Base" fontName="IPAexGothic" fontSize="7.5" pdfFontName="fonts/ipaexg.ttf" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <style name="Title" style="Base" fontSize="15" isBold="true"/>
    <style name="Header" style="Base" isBold="true" hTextAlign="Center" vTextAlign="Middle" mode="Opaque" backcolor="#DCE6F1">
        <box><pen lineWidth="0.5" lineColor="#1F2937"/></box>
    </style>
    <style name="Cell" style="Base" vTextAlign="Middle">
        <box><pen lineWidth="0.4" lineColor="#374151"/></box>
    </style>
    <style name="CellCenter" style="Cell" hTextAlign="Center"/>
    <style name="CellRight" style="Cell" hTextAlign="Right"/>
    <style name="PayHeader" style="Header" backcolor="#DCFCE7"/>
    <style name="DeductionHeader" style="Header" backcolor="#FEE2E2"/>
    <style name="NetHeader" style="Header" forecolor="#FFFFFF" backcolor="#1D4ED8"/>
    <style name="NetValue" style="CellRight" fontSize="10" isBold="true" forecolor="#1D4ED8"/>

    <parameter name="MONEY_FORMAT" class="java.text.DecimalFormat" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.text.DecimalFormat("#,##0;▲#,##0")]]></defaultValueExpression>
    </parameter>
    <parameter name="DATE_FORMAT" class="java.text.SimpleDateFormat" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("yyyy年M月d日")]]></defaultValueExpression>
    </parameter>

