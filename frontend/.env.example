VITE_API_BASE_URL=http://localhost:8080
VITE_APP_NAME=ProjectAdmin
# Syncfusion License & Downloadsで発行した、利用中パッケージと同じ
# メジャーバージョン用のライセンスキー。複数Editionを利用する場合は
# UI_EDITION_KEY;SPREADSHEET_EDITOR_KEY のようにセミコロンで連結する。
# 実値は.env.localまたはシェル環境変数へ設定し、Gitへコミットしないこと。
VITE_SYNCFUSION_LICENSE_KEY=
# Excel取込を使う場合だけ設定する。業務データを含むファイルは
# 外部デモサービスではなく、自社管理の変換サービスを指定すること。
VITE_SYNCFUSION_SPREADSHEET_OPEN_URL=

# ユーザーメニューから別タブで開くAtlassian Cloudの外部リンク。
# 公開情報だが、会社ごとの差し替えを可能にするため環境設定で管理する。
VITE_CONFLUENCE_MANUAL_URL=https://projectadmin1215.atlassian.net/wiki/spaces/~712020d0db24f25d734730b24dfb1508d24613/folder/19464193
VITE_JIRA_INCIDENT_FORM_URL=https://projectadmin1215.atlassian.net/jira/software/projects/FUYO/form/1?atlOrigin=eyJpIjoiYTFkN2E2NWU2YWYwNGQ2ODk4MDRmMTliM2JkMjQ3YjgiLCJwIjoiaiJ9
